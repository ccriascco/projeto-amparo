{
  "expo": {
    "name": "Amparo",
    "slug": "amparo",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "amparo",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "br.com.amparo.app"
    },
    "android": {
      "package": "br.com.amparo.app",
      "adaptiveIcon": {
        "backgroundColor": "#954B6E",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "single",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#954B6E",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120
        }
      ],
      "expo-secure-store",
      "expo-audio",
      "expo-video",
      "./plugins/nome-icone-disfarce",
      [
        "expo-alternate-app-icons",
        [
          {
            "name": "Calc",
            "ios": "./assets/images/calc-icon.png",
            "android": {
              "foregroundImage": "./assets/images/calc-icon-foreground.png",
              "backgroundColor": "#2F3437"
            }
          }
        ]
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
