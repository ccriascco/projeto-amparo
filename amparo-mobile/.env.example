# Endereço do backend do Amparo (amparo-backend).
# No celular físico, use o IP da sua máquina na rede local, não "localhost".
# Exemplo: http://192.168.0.10:3000
EXPO_PUBLIC_API_URL=http://localhost:3000

# Login com Google (opcional). IDs criados no Google Cloud Console.
# O "Web client ID" também precisa estar em GOOGLE_CLIENT_IDS no backend.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=
# Esquema de URL do iOS: o iOS client ID invertido (com.googleusercontent.apps.xxxx)
EXPO_PUBLIC_GOOGLE_IOS_URL_SCHEME=

# Mapa da tela "Alerta enviado" no Android (opcional). Chave do "Maps SDK for Android" criada no
# Google Cloud Console, restrita ao pacote br.com.amparo.app. Sem ela, o Android mostra a imagem do
# design no lugar do mapa. O iPhone usa o Apple Maps (sem chave) e a web usa o OpenStreetMap.
GOOGLE_MAPS_ANDROID_API_KEY=
