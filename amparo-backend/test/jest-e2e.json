{
  "moduleFileExtensions": ["js", "json", "ts"],
  "rootDir": "..",
  "testEnvironment": "node",
  "testRegex": ".e2e-spec.ts$",
  "transform": {
    "^.+\\.ts$": ["ts-jest", { "tsconfig": "tsconfig.spec.json" }],
    "^.+\\.js$": "babel-jest"
  },
  "transformIgnorePatterns": ["/node_modules/(?!(@nestjs)/)"],
  "setupFiles": ["<rootDir>/test/jest.setup.ts"]
}
